#!/usr/bin/env bash
# npg — nanoPlayground helper CLI (omarchy-style: one token-saving API for agents).
#   npg commands [--json]   list every command (single-call discovery)
#   npg sys info             OS/PID1/tools summary in one output
#   npg pkg update|add|search|rm|clean
#   npg svc status|enable|disable|run
#   npg skills sync|list
set -euo pipefail

NPG_SKILLS_SRC="${NPG_SKILLS_SRC:-/usr/share/nanoplayground/skills}"
VERSION="0.1.0"

is_void() { [[ -f /etc/void-release ]] && command -v xbps-install >/dev/null 2>&1; }
need_void() {
    if ! is_void; then
        echo "[npg] not Void Linux (no xbps) — refusing '$1' so the host stays safe." >&2
        exit 2
    fi
}
need_root_like() { :; } # all writes go through sudo by the caller; see each function.

# --- commands (token-saving discovery) ---------------------------------------
cmd_commands() {
    local json=0; [[ "${1:-}" == "--json" ]] && json=1
    # format: "group action|summary"
    local rows=(
        "sys info|OS, PID1, xbps/aoe/claude/opencode versions, service counts (1 call)"
        "pkg update|two-phase Void full update (xbps first, then system)"
        "pkg add <p..>|idempotent batch install (skip installed, 1 transaction)"
        "pkg search <pattern>|search repo packages (xbps-query -Rs)"
        "pkg rm <package>|remove package (+ unused deps)"
        "pkg clean|drop orphans + xbps cache"
        "svc status [name]|runit service status (fails cleanly when not PID1)"
        "svc enable <name>|enable+start (VM) / bake symlink (container)"
        "svc disable <name>|disable+stop"
        "svc run <name> [args]|run daemon in foreground inside container"
        "skills sync|symlink all skills into ~/.agents ~/.claude ~/.codex ~/.config/opencode"
        "skills list|list installed skills"
        "commands [--json]|this listing (discovery)"
    )
    if (( json )); then
        printf '{\n  "npg": "%s",\n  "commands": [\n' "$VERSION"
        local i=0; for r in "${rows[@]}"; do
            (( i )) && printf ',\n'
            printf '    {"cmd": "npg %s", "summary": "%s"}' "${r%%|*}" "${r#*|}"
            i=1
        done
        printf '\n  ]\n}\n'
    else
        echo "[npg $VERSION] available commands:"
        for r in "${rows[@]}"; do printf '  npg %-24s %s\n' "${r%%|*}" "${r#*|}"; done
    fi
}

# --- sys --------------------------------------------------------------------
cmd_sys() {
    case "${1:-}" in
        info)
            echo "os=$(cat /etc/void-release 2>/dev/null || grep PRETTY /etc/os-release 2>/dev/null || uname -s)"
            echo "pid1=$(ps -p 1 -o comm= 2>/dev/null || echo '?')"
            echo "runit_pid1=$([ "$(ps -p 1 -o comm= 2>/dev/null)" = "runit" ] && echo yes || echo no)"
            command -v xbps-query >/dev/null && echo "xbps=$(xbps-query -V 2>/dev/null | head -1)" || echo "xbps=missing"
            for b in aoe claude opencode; do
                command -v "$b" >/dev/null && echo "$b=$($b --version 2>/dev/null | head -1)" || echo "$b=missing"
            done
            echo "services_available=$(ls /etc/sv 2>/dev/null | wc -l)"
            echo "services_enabled=$(ls /var/service 2>/dev/null | wc -l)"
            ;;
        *) echo "usage: npg sys info" >&2; exit 2 ;;
    esac
}

# --- pkg --------------------------------------------------------------------
cmd_pkg() {
    need_void "pkg $1"
    local op="${1:-}"; shift || true
    case "$op" in
        update)
            sudo xbps-install -Suy xbps && sudo xbps-install -Suy
            ;;
        add)
            (( $# )) || { echo "usage: npg pkg add <packages...>" >&2; exit 2; }
            local missing=()
            for p in "$@"; do
                xbps-query -S "$p" >/dev/null 2>&1 || missing+=("$p")
            done
            if (( ${#missing[@]} == 0 )); then echo "[npg] already installed: $*"; return 0; fi
            echo "[npg] installing: ${missing[*]}"
            sudo xbps-install -Sy "${missing[@]}"
            for p in "${missing[@]}"; do xbps-query -S "$p" >/dev/null || { echo "[npg] verification failed: $p" >&2; exit 1; }; done
            ;;
        search)
            (( $# )) || { echo "usage: npg pkg search <pattern>" >&2; exit 2; }
            xbps-query -Rs "$1" | head -30
            ;;
        rm)
            (( $# )) || { echo "usage: npg pkg rm <package>" >&2; exit 2; }
            sudo xbps-remove -R "$1"
            ;;
        clean)
            sudo xbps-remove -Oo -y
            ;;
        *) echo "usage: npg pkg {update|add|search|rm|clean}" >&2; exit 2 ;;
    esac
}

# --- svc --------------------------------------------------------------------
cmd_svc() {
    need_void "svc $1"
    local op="${1:-}"; shift || true
    case "$op" in
        status)
            if [[ $# -eq 0 ]]; then sv status /var/service/* 2>&1 | head -30
            else sv status "$1" 2>&1; fi
            ;;
        enable)
            (( $# )) || { echo "usage: npg svc enable <name>" >&2; exit 2; }
            [[ -d "/etc/sv/$1" ]] || { echo "[npg] no such service: /etc/sv/$1" >&2; exit 1; }
            if [[ "$(ps -p 1 -o comm=)" == "runit" ]]; then
                sudo ln -sfn "/etc/sv/$1" /var/service/
            else
                # In a container: bake for VM boots + show the foreground way
                sudo ln -sfn "/etc/sv/$1" /etc/runit/runsvdir/default/ 2>/dev/null || sudo ln -sfn "/etc/sv/$1" /var/service/
                echo "[npg] not runit PID1 — enable baked in; run foreground via: npg svc run $1"
            fi
            ;;
        disable)
            (( $# )) || { echo "usage: npg svc disable <name>" >&2; exit 2; }
            sudo rm -f "/var/service/$1" "/etc/runit/runsvdir/default/$1"
            ;;
        run)
            (( $# )) || { echo "usage: npg svc run <name> [args...]" >&2; exit 2; }
            local svc="$1"; shift
            if [[ -x "/etc/sv/$svc/run" ]]; then exec "/etc/sv/$svc/run" "$@"
            else echo "[npg] no /etc/sv/$svc/run" >&2; exit 1; fi
            ;;
        *) echo "usage: npg svc {status|enable|disable|run}" >&2; exit 2 ;;
    esac
}

# --- skills (omarchy-style symlink installer) ----------------------------------
SKILL_TARGETS=(
    "$HOME/.agents/skills"
    "$HOME/.claude/skills"
    "$HOME/.codex/skills"
    "$HOME/.config/opencode/skills"
)
cmd_skills() {
    case "${1:-}" in
        sync)
            local src="$NPG_SKILLS_SRC"
            [[ -d "$src" ]] || { echo "[npg] skill source missing: $src" >&2; exit 1; }
            local n=0
            for d in "$src"/*/; do
                [[ -d "$d" ]] || continue
                local name; name="$(basename "$d")"
                for t in "${SKILL_TARGETS[@]}"; do
                    mkdir -p "$t"
                    ln -sfn "$d" "$t/$name"
                done
                n=$((n+1))
            done
            echo "[npg] synced $n skill(s) from $src"
            ;;
        list)
            for t in "${SKILL_TARGETS[@]}"; do
                echo "== $t"; ls -1 "$t" 2>/dev/null || echo "(empty)"
            done
            ;;
        *) echo "usage: npg skills {sync|list}" >&2; exit 2 ;;
    esac
}

# --- dispatch ---------------------------------------------------------------
main() {
    local grp="${1:-commands}"; shift || true
    case "$grp" in
        commands) cmd_commands "$@" ;;
        sys)      cmd_sys "$@" ;;
        pkg)      cmd_pkg "$@" ;;
        svc)      cmd_svc "$@" ;;
        skills)   cmd_skills "$@" ;;
        -h|--help|help) cmd_commands ;;
        -V|--version|version) echo "npg $VERSION" ;;
        *) echo "[npg] unknown command: $grp (try: npg commands)" >&2; exit 2 ;;
    esac
}
main "$@"
